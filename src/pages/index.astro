---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import SelectionEditor from '../components/SelectionEditor.astro';
import copySrc from '../scripts/copy.js?raw';
import pasteSrc from '../scripts/paste.js?raw';
import growSrc from '../scripts/grow.js?raw';
import relabelSrc from '../scripts/relabel.js?raw';
import deleteSrc from '../scripts/delete.js?raw';

/** Strip comments and collapse whitespace (string-aware) for the bookmarklets. */
function minify(src: string): string {
	let out = '';
	let i = 0;
	let mode: 'code' | 'line' | 'block' | 'str' = 'code';
	let quote = '';
	const punct = '{}();,.[]';
	while (i < src.length) {
		const c = src[i];
		const n = src[i + 1];
		if (mode === 'line') {
			if (c === '\n') {
				mode = 'code';
				out += ' ';
			}
			i++;
			continue;
		}
		if (mode === 'block') {
			if (c === '*' && n === '/') {
				mode = 'code';
				i += 2;
				continue;
			}
			if (c === '\n') out += ' ';
			i++;
			continue;
		}
		if (mode === 'str') {
			out += c;
			if (c === '\\') {
				out += n ?? '';
				i += 2;
				continue;
			}
			if (c === quote) mode = 'code';
			i++;
			continue;
		}
		if (c === '/' && n === '/') {
			mode = 'line';
			i += 2;
			continue;
		}
		if (c === '/' && n === '*') {
			mode = 'block';
			i += 2;
			continue;
		}
		if (c === "'" || c === '"' || c === '`') {
			mode = 'str';
			quote = c;
			out += c;
			i++;
			continue;
		}
		if (c === ' ' || c === '\n' || c === '\t' || c === '\r') {
			while (i < src.length && /\s/.test(src[i])) i++;
			const prev = out.slice(-1);
			const next = src[i] ?? '';
			if (!punct.includes(prev) && !punct.includes(next)) out += ' ';
			continue;
		}
		out += c;
		i++;
	}
	return out.trim();
}

const copyBm = minify(copySrc);
const pasteBm = minify(pasteSrc);
const growBm = minify(growSrc);
const relabelBm = minify(relabelSrc);
const deleteBm = minify(deleteSrc);

const steps = [
	'Open the source frame in CVAT and click COPY.',
	'(Optional) Open this site, paste into the Selection Editor, pick the labels you want, click "Copy selection".',
	'Go to the target frame in CVAT and click PASTE.',
	'(Optional) Boxes too tight? Click GROW on that frame and choose which labels to grow or shrink by 1–2 px.',
	'(Optional) Wrong label on a shape? Click RELABEL on that frame and swap one label for another.',
	'(Optional) Objects you do not want at all? Click DELETE on that frame and tick the labels to remove.',
	'Review the boxes, then press CVAT’s own Save button. Nothing reaches the server until then.',
];

const troubleshooting = [
	{
		q: 'Chrome blocks pasting into the console',
		a: 'Click into the console once and type allow pasting, then press Enter. Chrome only asks this the first time.',
	},
	{
		q: 'Pasted boxes don’t show up',
		a: 'Change frame and come back — the canvas sometimes doesn’t redraw after an internal paste.',
	},
	{
		q: 'The Save button is greyed out',
		a: 'Nudge any box slightly. CVAT only marks the job as dirty after a real edit, and the paste counts as one.',
	},
	{
		q: 'Clipboard is blocked',
		a: 'Allow clipboard permission for this site (the padlock in the address bar). If PASTE can’t read the clipboard it falls back to the last COPY, which contains all labels.',
	},
	{
		q: 'Wrong shapes were pasted',
		a: 'The clipboard was overwritten by something else after "Copy selection". Redo "Copy selection" here, then PASTE again.',
	},
	{
		q: 'GROW panel did not change anything',
		a: 'Tick the labels you want in the panel, then click Grow (or Shrink). If the canvas looks unchanged, change frame and come back, then press Save.',
	},
	{
		q: 'RELABEL did not change anything',
		a: 'Pick the label to replace and the label to use, then click Replace label. Locked objects and tracks are skipped — a track keeps one label for every frame it spans, so relabel it from the objects sidebar instead.',
	},
	{
		q: 'DELETE found no objects',
		a: 'DELETE reads the annotation collection, so it sees every label on the frame even when CVAT’s own filters hide some of them. If the list is still empty, the frame really has no annotations — switch the scope to “Whole job” to look at every frame.',
	},
];

---

<Layout>
	<main class="editorial-shell mx-auto max-w-5xl px-4 py-8 sm:px-8 sm:py-14">
		<!-- 1. Hero -->
		<header class="editorial-hero mb-16">
			<div class="editorial-kicker">
				<span>Field notes / 01</span>
				<span>CVAT utility</span>
			</div>
			<div class="editorial-mark" aria-hidden="true">↗</div>
			<h1 class="max-w-4xl text-5xl font-bold tracking-tight sm:text-7xl">
				Move the work<br /><em>with you.</em>
			</h1>
			<p class="editorial-dek mx-auto mt-6 max-w-2xl">
				CVAT can’t copy annotations between frames — these bookmarklets can,
				with an optional editor to pick exactly which shapes travel, a panel
				to nudge box sizes by a pixel or two, one to swap a wrong label for the
				right one, and one to delete the labels you never wanted.
			</p>
		</header>

		<!-- 2. Install -->
		<section id="install" class="editorial-section mb-16 space-y-5">
			<div class="section-heading"><span>02</span><h2>Install</h2></div>
			<p class="editorial-copy">
				Drag a link onto your bookmarks bar, or open the CVAT tab, open the console
				(<kbd class="rounded border border-zinc-300 px-1 text-xs dark:border-zinc-700">Ctrl+Shift+J</kbd>)
				and paste the code.
			</p>
			<div class="grid gap-5 sm:grid-cols-2">
				{
				[
					{ id: 'copy', title: 'COPY', desc: 'Runs on the source frame. Puts its shapes on the clipboard.', src: copySrc },
					{ id: 'paste', title: 'PASTE', desc: 'Runs on the target frame. Pastes the selection (or last COPY).', src: pasteSrc },
					{ id: 'grow', title: 'GROW', desc: 'Runs on the frame you are viewing. Opens a panel to grow or shrink chosen labels by 1–2 px.', src: growSrc },
					{ id: 'relabel', title: 'RELABEL', desc: 'Runs on the frame you are viewing. Replaces one label with another — either direction.', src: relabelSrc },
					{ id: 'delete', title: 'DELETE', desc: 'Runs on the frame you are viewing. Lists every label on the frame and removes the objects you tick.', src: deleteSrc },
				].map((s) => (
						<div class="editorial-card flex flex-col gap-4 p-6">
							<div>
								<div class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">Bookmarklet</div>
								<h3 class="text-2xl font-bold">{s.title}</h3>
								<p class="mt-1 text-sm text-[var(--muted)]">{s.desc}</p>
							</div>
							<a
								id={`bm-${s.id}`}
								href="#install"
								title="Drag me to your bookmarks bar"
								class="btn btn-primary self-start"
							>
								⤒ {s.title} bookmarklet
							</a>
							<button
								id={`copy-code-${s.id}`}
								type="button"
								class="btn btn-secondary self-start"
							>
								Copy code
							</button>
							<details>
								<summary class="cursor-pointer text-sm text-zinc-600 dark:text-zinc-400">
									Show source
								</summary>
								<pre
									class="scroll-area mt-2 max-h-72 rounded-xl bg-zinc-950 text-xs"><Code
										code={s.src}
										lang="js"
										theme="github-dark"
									/></pre>
							</details>
						</div>
					))
				}
			</div>
		</section>

		<!-- 3. How to use -->
		<section class="editorial-section mb-16">
			<div class="section-heading"><span>03</span><h2>How to use</h2></div>
			<ol class="editorial-steps">
				{steps.map((s, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><p>{s}</p></li>)}
			</ol>
		</section>

		<!-- 4. Selection Editor -->
		<section id="selection-editor" class="editorial-section mb-16">
			<div class="section-heading"><span>04</span><h2>Selection Editor</h2></div>
			<p class="editorial-copy mb-5">
				Optional: paste the copied data, remove what you don’t need, then send the
				selection back to PASTE. Everything stays in your browser.
			</p>
			<div class="editorial-card p-4 sm:p-7">
				<SelectionEditor pasteScript={pasteSrc} />
			</div>
		</section>

		<!-- 5. Options -->
		<section class="editorial-section mb-16">
			<div class="section-heading"><span>05</span><h2>Filter labels in COPY</h2></div>
			<p class="editorial-copy mb-4">
				The COPY script has a <code class="rounded bg-zinc-100 px-1 dark:bg-zinc-800">LABELS</code>
				filter. Leave it empty (<code class="rounded bg-zinc-100 px-1 dark:bg-zinc-800">[]</code>)
				to copy every shape, or list the labels you care about, e.g.
				<code class="rounded bg-zinc-100 px-1 dark:bg-zinc-800">['gate']</code>.
				Editing the field below regenerates the COPY bookmarklet and its code.
			</p>
			<label for="labels-input" class="mb-1 block text-sm font-medium"
				>LABELS array</label
			>
			<input
				id="labels-input"
				type="text"
				defaultValue="[]"
				spellcheck="false"
				class="w-full rounded-lg border border-zinc-300 bg-zinc-50 p-2 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-zinc-700 dark:bg-zinc-900"
			/>
			<p id="labels-hint" class="hidden mt-1 text-sm text-red-600 dark:text-red-400"></p>
		</section>

		<!-- 6. Troubleshooting -->
		<section class="editorial-section mb-16">
			<div class="section-heading"><span>06</span><h2>Troubleshooting</h2></div>
			<div class="editorial-faq divide-y">
				{
					troubleshooting.map((t) => (
						<details class="group p-4">
							<summary class="cursor-pointer font-medium">{t.q}</summary>
							<p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{t.a}</p>
						</details>
					))
				}
			</div>
		</section>

		<!-- 7. Footer -->
		<footer class="editorial-footer pt-6 text-sm">
			<p>
				The scripts reach into CVAT’s internal React/Redux state, so they may break on
				other CVAT versions. Everything runs in your browser — no data is sent anywhere.
			</p>
		</footer>
	</main>
</Layout>

<script is:inline define:vars={{ copyRaw: copySrc, pasteRaw: pasteSrc, growRaw: growSrc, relabelRaw: relabelSrc, deleteRaw: deleteSrc, copyBm, pasteBm, growBm, relabelBm, deleteBm }}>
	(function () {
		var currentCopyRaw = copyRaw;
		var currentCopyBm = copyBm;
		var raws = { copy: function () { return currentCopyRaw; }, paste: function () { return pasteRaw; }, grow: function () { return growRaw; }, relabel: function () { return relabelRaw; }, delete: function () { return deleteRaw; } };

		function apply(id, code) {
			var a = document.getElementById(id);
			// Astro may sanitize javascript: hrefs, so set them at runtime.
			if (a) a.href = 'javascript:' + encodeURIComponent(code);
		}
		apply('bm-copy', copyBm);
		apply('bm-paste', pasteBm);
		apply('bm-grow', growBm);
		apply('bm-relabel', relabelBm);
		apply('bm-delete', deleteBm);

		function flash(btn, text) {
			btn.textContent = text;
			setTimeout(function () {
				btn.textContent = 'Copy code';
			}, 1500);
		}

		function copyText(text) {
			if (navigator.clipboard && navigator.clipboard.writeText) {
				return navigator.clipboard.writeText(text).catch(function () {
					return copyTextFallback(text);
				});
			}
			return copyTextFallback(text);
		}

		function copyTextFallback(text) {
			var textarea = document.createElement('textarea');
			textarea.value = text;
			textarea.setAttribute('readonly', '');
			textarea.style.position = 'fixed';
			textarea.style.opacity = '0';
			document.body.appendChild(textarea);
			textarea.select();
			var copied = false;
			try {
				copied = document.execCommand('copy');
			} finally {
				textarea.remove();
			}
			return copied ? Promise.resolve() : Promise.reject(new Error('Clipboard write blocked'));
		}

		['copy', 'paste', 'grow', 'relabel', 'delete'].forEach(function (id) {
			var btn = document.getElementById('copy-code-' + id);
			if (!btn) return;
			btn.addEventListener('click', function () {
				copyText(raws[id]())
					.then(function () {
						flash(btn, 'Copied!');
					})
					.catch(function () {
						flash(btn, 'Clipboard blocked');
					});
			});
		});

		var input = document.getElementById('labels-input');
		var hint = document.getElementById('labels-hint');
		input.addEventListener('input', function () {
			var v = input.value.trim() || '[]';
			var ok = /^\[\s*('[^']*'|"[^"]*")?(\s*,\s*('[^']*'|"[^"]*"))*\s*\]$/.test(v);
			if (!ok) {
				hint.textContent = "Use JS array syntax, e.g. [] or ['gate']";
				hint.classList.remove('hidden');
				return;
			}
			hint.classList.add('hidden');
			currentCopyRaw = copyRaw.replace(/const LABELS = \[[^\]]*\]/, 'const LABELS = ' + v);
			currentCopyBm = copyBm.replace(/const LABELS\s*=\s*\[[^\]]*\]/, 'const LABELS=' + v);
			apply('bm-copy', currentCopyBm);
		});
	})();
</script>
